@* La portada organiza el mensaje principal y las formas de dar el primer paso. *@
@{
    ViewData["Title"] = "Inicio";
    ViewData["Description"] = "Biodescodificación simple y gestión emocional para dejar de repetir historias y darle un giro a tu vida.";
}

<section class="hero section-pad">
    <div class="shell hero-grid">
        <div class="hero-copy reveal">
            <span class="eyebrow">Biodescodificación y gestión emocional</span>
            <h1>Biodescodificación simple y gestión emocional para dejar de repetir historias y darle, por fin, un <em>giro</em> a tu vida.</h1>
            <p class="lead">Un espacio de acompañamiento para comprender el origen emocional de aquello que se repite, recuperar claridad y comenzar a construir una respuesta diferente.</p>
            <div class="button-row">
                <a class="button" href="https://wa.me/543512233519" target="_blank" rel="noopener">Agendá tu sesión</a>
                <a class="button button-outline" href="#presentacion">Conocé mi enfoque</a>
            </div>
            <div class="trust-row" aria-label="Características de las sesiones">
                <span>Encuentros 100% online</span>
                <span>Atención personalizada</span>
                <span>Desde cualquier lugar</span>
            </div>
        </div>
        <div class="hero-visual reveal delay-one">
            <span class="hero-sun" aria-hidden="true"></span>
            <img class="hero-photo" src="~/images/giro-hero.webp" width="1280" height="853" alt="Un espacio cálido y sereno que representa la propuesta de GIRO" fetchpriority="high" />
            <blockquote>
                Cambiar la perspectiva también es avanzar.
                <cite>GIRO · Martín Ruiz</cite>
            </blockquote>
        </div>
    </div>
</section>

@* Un recorrido simple ayuda a comprender cómo comenzar. *@
<section class="process-section section-pad">
    <div class="shell">
        <div class="section-heading">
            <div><span class="eyebrow">Cómo empezar</span><h2>Un proceso claro, humano y a tu ritmo</h2></div>
            <p>No necesitás saber de antemano qué servicio elegir. Empezamos por lo que hoy te está pasando.</p>
        </div>
        <div class="three-grid process-grid">
            <article class="number-card"><span>01</span><h3>Contame</h3><p>Escribile a Martín por WhatsApp y compartí brevemente qué te gustaría trabajar.</p></article>
            <article class="number-card"><span>02</span><h3>Orientación</h3><p>Juntos identifican qué propuesta puede acompañar mejor tu momento actual.</p></article>
            <article class="number-card"><span>03</span><h3>Encuentro</h3><p>Coordinan una sesión online, en un espacio privado y sin interrupciones.</p></article>
        </div>
    </div>
</section>

@* La presentación conecta la propuesta con una voz personal y cercana. *@
<section class="intro-band section-pad" id="presentacion">
    <div class="shell intro-grid">
        <div class="intro-mark" aria-hidden="true">M<span>R</span></div>
        <div class="section-copy">
            <span class="eyebrow">El enfoque GIRO</span>
            <h2>Un giro comienza cuando dejás de mirar para otro lado</h2>
            <p>Soy Martín Ruiz. Acompaño a personas que desean comprender sus conflictos emocionales, reconocer patrones repetitivos y encontrar nuevas formas de responder a su historia.</p>
            <a class="button button-outline" asp-controller="Home" asp-action="SobreMi">Conocé mi historia</a>
        </div>
    </div>
</section>

@* Cada tarjeta presenta una propuesta sin prometer resultados médicos. *@
<section class="services-section section-pad">
    <div class="shell">
        <div class="section-heading"><div><span class="eyebrow">Servicios</span><h2>Un espacio para mirar tu historia con más claridad</h2></div></div>
        <div class="service-list">
            <article class="service-mini"><span>01</span><h3>Sesiones individuales de Biodescodificación</h3><p>Un encuentro de escucha y reflexión para observar emociones y situaciones que se repiten.</p></article>
            <article class="service-mini"><span>02</span><h3>Análisis Transgeneracional</h3><p>Una mirada sobre historias y patrones familiares que pueden estar presentes en tu experiencia.</p></article>
            <article class="service-mini"><span>03</span><h3>Proyecto Sentido</h3><p>Un espacio para explorar expectativas, mandatos y aprendizajes vinculados a tu historia.</p></article>
            <article class="service-mini"><span>04</span><h3>Pausa &amp; Papel</h3><p>Una propuesta de escritura consciente para ordenar ideas y expresar lo que sentís.</p></article>
        </div>
    </div>
</section>

@* El recurso gratuito funciona como una invitación independiente al contacto. *@
<section class="kit-band section-pad">
    <div class="shell kit-grid">
        <div class="kit-cover" aria-label="Composición de El Kit del Giro"><span>Una guía para observar</span><strong>EL KIT<br />DEL GIRO</strong><small>Gratis · cinco pasos</small></div>
        <div class="section-copy"><span class="eyebrow">Recurso gratuito</span><h2>¿Atrapado en el mismo bucle de siempre?</h2><p>Empezá a salir hoy gratis con una guía de cinco pasos para observar tus síntomas físicos o emocionales desde una perspectiva diferente.</p><a class="button" href="~/docs/Kit-del-Giro.pdf" download>Descargá El Kit del Giro</a></div>
    </div>
</section>

@* La solicitud se envía a Martín por WhatsApp para no almacenar datos en el sitio. *@
<section class="newsletter section-pad">
    <div class="shell newsletter-grid">
        <div><span class="eyebrow">Mensajes de regalo</span><h2>“Que tu vida no pase como un barco sin luces por la noche.”</h2><p>Recibí reflexiones periódicas para acompañar tu camino. La suscripción es gratuita y podés cancelarla cuando quieras.</p></div>
        <form class="newsletter-form" data-newsletter-form novalidate>
            <label for="newsletter-email">Tu correo electrónico</label>
            <div><input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="tuemail@ejemplo.com" required /><button class="button" type="submit">Suscribirme</button></div>
            <p class="form-feedback" role="status" data-form-feedback></p>
            <small class="microcopy">Al continuar se abrirá WhatsApp con tu solicitud. El sitio no almacena tu correo.</small>
        </form>
    </div>
</section>

@* El cierre deja una llamada a la conversación directa. *@
<section class="dark-cta section-pad"><div class="shell split-cta"><div><span class="eyebrow eyebrow-light">Un primer paso</span><h2>Tu historia puede comenzar a escribirse de otra manera</h2></div><a class="button button-cream" href="https://wa.me/543512233519" target="_blank" rel="noopener">Charlá conmigo</a></div></section>
