@* Botón flotante que abre el asistente de GIRO sin abandonar la página actual. *@
<button class="assistant-launcher" type="button" aria-label="Abrir asistente virtual GIRO" aria-expanded="false" data-assistant-launcher>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.2 9.2 0 0 1-3.8-.8L3 21l1.7-4.5A8.1 8.1 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"/><path d="M8 12h.01M12 12h.01M16 12h.01"/></svg>
    <span>GIRO</span>
</button>

<section class="assistant-panel" role="dialog" aria-label="Asistente virtual GIRO" aria-hidden="true" data-assistant-panel>
    <header class="assistant-header">
        <div class="assistant-avatar" aria-hidden="true">J</div>
        <div>
            <strong>GIRO</strong>
            <span><i></i> Asistente virtual</span>
        </div>
        <button type="button" aria-label="Cerrar asistente" data-assistant-close>×</button>
    </header>

    <div class="assistant-messages" role="log" aria-live="polite" data-assistant-messages>
        <div class="chat-row assistant-row">
            <span class="chat-avatar" aria-hidden="true">G</span>
            <div class="chat-bubble">Hola, soy el asistente virtual de GIRO. Puedo orientarte sobre las sesiones de Martín, sus servicios y las formas de contacto. No realizo diagnósticos ni reemplazo la atención profesional.</div>
        </div>
    </div>

    <div class="assistant-suggestions" data-assistant-suggestions>
        <button type="button" data-question="¿Cuál es la diferencia entre los 4 servicios y cuál necesito hoy?">¿Cuál es la diferencia entre los 4 servicios y cuál necesito hoy?</button>
        <button type="button" data-question="¿Cómo sé si mi problema es propio o viene de mi árbol (Transgeneracional)?">¿Cómo sé si mi problema es propio o viene de mi árbol (Transgeneracional)?</button>
        <button type="button" data-question="¿Qué se trabaja en una sesión de Proyecto Sentido?">¿Qué se trabaja en una sesión de Proyecto Sentido?</button>
        <button type="button" data-question="¿Cuántas sesiones individuales necesito para ver cambios?">¿Cuántas sesiones individuales necesito para ver cambios?</button>
        <button type="button" data-question="¿Qué valor tienen tus servicios y qué incluye Pausa y Papel?">¿Qué valor tienen tus servicios y qué incluye Pausa y Papel?</button>
        <button type="button" data-question="¿Cómo son las sesiones individuales y desde dónde puedo tomarlas?">¿Cómo son las sesiones individuales y desde dónde puedo tomarlas?</button>
    </div>

    <form class="assistant-form" data-assistant-form>
        <label class="visually-hidden" for="assistant-input">Escribí tu consulta</label>
        <input id="assistant-input" name="message" maxlength="500" autocomplete="off" placeholder="Escribí tu consulta…" required data-assistant-input />
        <button type="submit" aria-label="Enviar consulta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></svg>
        </button>
    </form>

    <p class="assistant-note">Privacidad: no guardo esta conversación. El asistente GIRO no brinda diagnósticos ni reemplaza la atención médica, psicológica o psiquiátrica.</p>
    <a class="assistant-whatsapp" href="https://wa.me/543512233519" target="_blank" rel="noopener">Hablar con Martín por WhatsApp</a>
</section>
