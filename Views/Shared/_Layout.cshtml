@* Datos compartidos para definir el título y la descripción de cada página. *@
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var pageDescription = ViewData["Description"]?.ToString()
        ?? "GIRO: espacio de autoconocimiento, Biodescodificación y gestión emocional con Martín Ruiz. Sesiones, recursos y escritura consciente.";
    var pageTitle = $"{ViewData["Title"]} | GIRO — Martín Ruiz";
    const string siteUrl = "https://martinruiz.online";
    var canonicalPath = Context.Request.Path.Value ?? "/";
    if (canonicalPath.Length > 1)
    {
        canonicalPath = canonicalPath.TrimEnd('/');
    }
    var canonicalUrl = $"{siteUrl}{canonicalPath}";
    var socialImageUrl = $"{siteUrl}/images/giro-social.jpg";
    var robotsDirective = ViewData["Robots"]?.ToString() ?? "index, follow";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@pageDescription" />
    <meta name="author" content="Martín Ruiz" />
    <meta name="robots" content="@robotsDirective" />
    <meta name="theme-color" content="#173f38" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GIRO — Martín Ruiz" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@socialImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GIRO — Biodescodificación y escritura expresiva con Martín Ruiz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@socialImageUrl" />
    <meta name="twitter:image:alt" content="GIRO — Biodescodificación y escritura expresiva con Martín Ruiz" />
    <title>@pageTitle</title>
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="es" href="@canonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
    <link rel="sitemap" type="application/xml" href="@(siteUrl + "/sitemap.xml")" />
    <link rel="icon" type="image/svg+xml" href="~/images/giro-favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/premium.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contrast-fix.css" asp-append-version="true" />

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@graph": [
            {
                "@@type": "Person",
                "@@id": "@(siteUrl + "/#martin-ruiz")",
                "name": "Martín Ruiz",
                "jobTitle": "Consultor en Decodificación Bioemocional",
                "description": "Biodescodificación y escritura expresiva para acompañar procesos de autoconocimiento.",
                "url": "@(siteUrl + "/sobre-mi")",
                "email": "mailto:martin.mrj@gmail.com",
                "telephone": "+54 351 2233519",
                "homeLocation": {
                    "@@type": "Place",
                    "name": "La Calera, Córdoba, Argentina"
                },
                "sameAs": [
                    "https://www.instagram.com/martinruiz.bio/",
                    "https://www.youtube.com/@@bio-giro",
                    "https://www.tiktok.com/@@martinruizjimenez",
                    "https://www.facebook.com/share/1AC4HvErj5/"
                ],
                "knowsAbout": [
                    "Biodescodificación",
                    "Decodificación Bioemocional",
                    "Escritura expresiva",
                    "Gestión emocional",
                    "Autoconocimiento"
                ]
            },
            {
                "@@type": "WebSite",
                "@@id": "@(siteUrl + "/#website")",
                "url": "@siteUrl",
                "name": "GIRO — Martín Ruiz",
                "inLanguage": "es",
                "publisher": { "@@id": "@(siteUrl + "/#martin-ruiz")" }
            },
            {
                "@@type": "Service",
                "@@id": "@(siteUrl + "/#servicio")",
                "name": "Biodescodificación y escritura expresiva",
                "serviceType": [
                    "Biodescodificación",
                    "Decodificación Bioemocional",
                    "Pausa & Papel"
                ],
                "provider": { "@@id": "@(siteUrl + "/#martin-ruiz")" },
                "areaServed": {
                    "@@type": "Place",
                    "name": "Países de habla hispana"
                },
                "availableChannel": {
                    "@@type": "ServiceChannel",
                    "serviceUrl": "@(siteUrl + "/contacto")",
                    "availableLanguage": "es"
                }
            }
        ]
    }
    </script>
</head>
<body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido</a>

    @* El encabezado conserva la navegación visible y se adapta a pantallas pequeñas. *@
    <header class="site-header" data-site-header>
        <div class="shell header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="GIRO, ir al inicio">
                <img class="brand-logo" src="~/images/giro-logo-transparent.webp" alt="" width="720" height="264" />
                <span class="visually-hidden">GIRO — Martín Ruiz</span>
            </a>

            <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="main-navigation" data-menu-button>
                <span></span><span></span><span></span>
            </button>

            <nav class="main-nav" id="main-navigation" aria-label="Navegación principal" data-main-nav>
                <a class="@(currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                <a class="@(currentAction == "SobreMi" ? "active" : "")" asp-controller="Home" asp-action="SobreMi">Sobre mí</a>
                <a class="@(currentAction == "Biodescodificacion" ? "active" : "")" asp-controller="Home" asp-action="Biodescodificacion">Biodescodificación</a>
                <a class="@(currentAction == "Servicios" ? "active" : "")" asp-controller="Home" asp-action="Servicios">Servicios</a>
                <a class="@(currentAction == "Mensajes" ? "active" : "")" asp-controller="Home" asp-action="Mensajes">Mensajes</a>
                <a class="@(currentAction == "PausaPapel" ? "active" : "")" asp-controller="Home" asp-action="PausaPapel">Pausa &amp; Papel</a>
                <a class="@(currentAction == "Contacto" ? "active" : "")" asp-controller="Home" asp-action="Contacto">Contacto</a>
            </nav>

            <a class="button button-small header-action" href="https://wa.me/543512233519" target="_blank" rel="noopener">Agendá tu sesión</a>
        </div>
    </header>

    <main id="contenido-principal">
        @RenderBody()
    </main>

    @* El pie reúne contacto, navegación secundaria y el alcance del acompañamiento. *@
    <footer class="site-footer">
        <div class="shell footer-grid">
            <div>
                <a class="brand brand-footer" asp-controller="Home" asp-action="Index">
                    <img class="brand-logo brand-logo-footer" src="~/images/giro-logo-transparent.webp" alt="GIRO" width="720" height="264" loading="lazy" />
                </a>
                <p>Un espacio de autoconocimiento, reflexión y gestión emocional para mirar tu historia con más claridad.</p>
            </div>
            <div>
                <h2>Explorar</h2>
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="SobreMi">Sobre mí</a>
                    <a asp-controller="Home" asp-action="Biodescodificacion">El enfoque</a>
                    <a asp-controller="Home" asp-action="Servicios">Servicios</a>
                    <a asp-controller="Home" asp-action="Kit">El Kit del Giro</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
            </div>
            <div>
                <h2>Contacto</h2>
                <div class="footer-links">
                    <a href="https://wa.me/543512233519" target="_blank" rel="noopener">+54 351 2233519</a>
                    <a href="https://www.instagram.com/martinruiz.bio/" target="_blank" rel="noopener">Instagram</a>
                    <a href="https://www.youtube.com/@@bio-giro" target="_blank" rel="noopener">YouTube</a>
                    <a href="https://www.tiktok.com/@@martinruizjimenez" target="_blank" rel="noopener">TikTok</a>
                    <a href="https://www.facebook.com/share/1AC4HvErj5/" target="_blank" rel="noopener">Facebook</a>
                    <a href="mailto:martin.mrj@gmail.com">martin.mrj@gmail.com</a>
                </div>
            </div>
        </div>
        <div class="shell footer-bottom">
            <span>© @DateTime.Now.Year GIRO. Todos los derechos reservados.</span>
            <span>Acompañamiento complementario · No reemplaza atención médica, psicológica o psiquiátrica.</span>
        </div>
    </footer>

    @* El asistente GIRO está disponible en todas las páginas porque vive dentro del layout. *@
    <partial name="_AssistantWidget" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
